# Base dos arquivos oficiais de divulgação do TSE.
# Padrão: https://resultados.tse.jus.br/oficial
# Para testes locais com fixtures: http://localhost:8787/oficial (npm run fixtures:serve)
VITE_TSE_BASE_URL=https://resultados.tse.jus.br/oficial

# Intervalo de atualização automática em segundos. Valores abaixo de 30 são ignorados (mínimo 30).
VITE_REFRESH_INTERVAL_SECONDS=30

# Idade (em segundos) a partir da qual os dados são sinalizados como desatualizados.
VITE_STALE_AFTER_SECONDS=120
